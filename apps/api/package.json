{
  "name": "@minicrm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "node ../../scripts/prisma.mjs generate",
    "db:migrate": "node ../../scripts/prisma.mjs migrate deploy",
    "db:migrate:create": "node ../../scripts/prisma.mjs migrate dev",
    "db:seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@minicrm/shared": "1.0.0",
    "@prisma/client": "6.12.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
